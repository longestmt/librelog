{
  "name": "librelog",
  "version": "0.4.2",
  "description": "A libre, FLOSS meal tracking app — track calories, macros, and nutrition.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:e2e:all": "npm run build && playwright test",
    "check": "npm run test:unit && npm run test:e2e",
    "check:all": "npm run test:unit && npm run test:e2e:all",
    "native:sync": "npm run build && cap sync"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "8.4.2",
    "@playwright/test": "^1.62.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.5",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.5.0",
    "@ericblade/quagga2": "1.12.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "baseline-browser-mapping": "2.11.21",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "fast-uri": "3.1.6",
    "filelist": "2.0.2",
    "nanoid": "3.3.18"
  }
}
